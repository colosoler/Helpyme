# =============================================================================
# Helpyme — plantilla de variables de entorno
# Copiar a .env (web) y a apps/api/.dev.vars (worker). NUNCA commitear valores.
# =============================================================================

# --- Base de datos (Neon PostgreSQL, driver serverless sobre HTTP) -----------
# Formato: postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# --- Autenticación (Better Auth) --------------------------------------------
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Anthropic (capa de asesoramiento conversacional) -----------------------
ANTHROPIC_API_KEY=
# Modelo por defecto del asesor. Ver docs/adr/0007-modelo-llm.md
ANTHROPIC_MODEL=claude-opus-5

# --- Mercado Pago (OAuth de la aplicación) ----------------------------------
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/integrations/mercadopago/callback

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- API --------------------------------------------------------------------
# Orígenes permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
